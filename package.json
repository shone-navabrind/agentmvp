{
  "name": "agentmvp",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm start -w @harness/api",
    "shots": "node apps/web/shots.mjs docs/screenshots",
    "a11y": "node apps/web/a11y.mjs",
    "audit:ui": "npm run a11y && npm run a11y:manual",
    "a11y:manual": "node apps/web/a11y-manual.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.10.2"
  }
}
